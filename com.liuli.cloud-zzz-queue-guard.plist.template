<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.liuli.cloud-zzz-queue-guard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__PROJECT_DIR__/cloud_zzz_queue_guard.py</string>
        <string>--config</string>
        <string>__PROJECT_DIR__/config.json</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>ThrottleInterval</key>
    <integer>1</integer>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.miHoYo.cloudgames.Nap</string>
    </array>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/guard.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/guard.log</string>
</dict>
</plist>
